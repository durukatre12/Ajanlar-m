# Kopyala: cp .env.example .env — sonra değerleri doldur. `.env` git'e GİRMEZ.

# Telegram botu: @BotFather ile bot aç, token'ı buraya yapıştır.
TELEGRAM_BOT_TOKEN=
# Bota bir mesaj at, sonra `python3 bin/telegram_oku.py --chat-id-bul` çalıştır, çıkan sayıyı yaz.
TELEGRAM_CHAT_ID=

# Bekçi için ayrı aile (ANAYASA 3). Boş bırakılırsa yedek yol Haiku'dur ve karar
# "bekçi aynı aileden — uyarı" notuyla kaydedilir.
OPENAI_API_KEY=

# --- farklı model (opsiyonel, bkz. docs/07-farkli-model.md) ---
# NVIDIA'nın ücretsiz model kataloğu: build.nvidia.com → bir model kartında "Get API Key".
# Boşsa hiçbir şey değişmez: bütün takımlar Anthropic'te (Claude aboneliğinle) koşar.
NVIDIA_API_KEY=
# Koşacak NIM modeli, ör. meta/llama-3.3-70b-instruct — TOOL-USE desteklemeli.
NIM_MODEL=
